# Copy to .env for local testing, or set these as Render environment
# variables in production. Nothing in this repo hardcodes real credentials.

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
COURSE_DELIVERY_URL=https://aimadesimple40plus.com/access
DOMAIN=https://ai-made-simple-landing.onrender.com

# Powers the PromptComparator demo widget (/api/prompt-demo). Get one from
# console.anthropic.com -> API Keys. Never exposed to the frontend -- the
# widget calls our own backend route, which holds this key server-side.
ANTHROPIC_API_KEY=
